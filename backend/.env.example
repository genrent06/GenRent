# ── App ──────────────────────────────────────────────
ENV=production
APP_PORT=8080

# MUST be changed — 32+ random characters
JWT_SECRET=replace-with-a-strong-random-secret

# Comma-separated allowed origins (no trailing slash)
ALLOWED_ORIGINS=https://genrent.in,https://www.genrent.in

# Base URL for email links (IMPORTANT: Update to your actual domain)
BASE_URL=https://genrent.in

# ── Database ─────────────────────────────────────────
DB_USER=genrent
DB_PASSWORD=replace-with-strong-db-password
DB_NAME=genrent

# ── Email (Gmail SMTP) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=GenRent

# ── Payment Gateway ──────────────────────────────────
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Domain ───────────────────────────────────────────
# Used by Caddy for automatic TLS — must point to this server's IP
DOMAIN=genrent.in

# ── Backup ───────────────────────────────────────────
BACKUP_DIR=/var/backups/genrent
RETAIN_DAYS=7

# ── Platform Fees ───────────────────────────────────
PLATFORM_FEE_PERCENT=10.0
REFUND_AUTO_PROCESS=true
PAYMENT_TIMEOUT=900
